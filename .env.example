# Database
DATABASE_URL="postgresql://meinkun:meinkun@localhost:54321/meinkun?schema=public"

# Next.js auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret"

# Cookie flag for the admin session. Defaults to NODE_ENV=production (true).
# Set to "false" when serving over plain HTTP (e.g. access by IP without TLS),
# otherwise the browser drops the session cookie and admin login never sticks.
# AUTH_COOKIE_SECURE="false"

# Admin credentials (used to seed the single admin account)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-me"

# S3-compatible object storage (MinIO)
S3_ENDPOINT="localhost"
S3_PORT="9000"
S3_USE_SSL="false"
S3_ACCESS_KEY="meinkun"
S3_SECRET_KEY="meinkun-secret"
S3_BUCKET="meinkun-photos"

# Public URL of the S3/MinIO endpoint (must be reachable from visitors' browsers).
# These two MUST have the NEXT_PUBLIC_ prefix: they are used in client components.
NEXT_PUBLIC_S3_BUCKET="meinkun-photos"
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE_DISPLAY="+7 (903) 622-01-42"
NEXT_PUBLIC_PHONE_TEL="+79036220142"
NEXT_PUBLIC_EMAIL="jpankova103@gmail.com"
# Social links (leave empty to hide on the contacts page)
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""