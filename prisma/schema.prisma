generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnimalCategory {
  KITTEN
  MALE
  FEMALE
}

enum AnimalStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum ProductCategory {
  BED
  FURNITURE
}

model Animal {
  id            String         @id @default(cuid())
  category      AnimalCategory
  number        String?
  name          String
  birthDate     DateTime?
  sex           String?
  color         String?
  price         Int?
  personality   String?
  fatherId      String?
  motherId      String?
  father        Animal?        @relation("AnimalFather", fields: [fatherId], references: [id], onDelete: SetNull)
  mother        Animal?        @relation("AnimalMother", fields: [motherId], references: [id], onDelete: SetNull)
  fatherOf      Animal[]       @relation("AnimalFather")
  motherOf      Animal[]       @relation("AnimalMother")
  status        AnimalStatus   @default(AVAILABLE)
  published     Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        AnimalPhoto[]

  @@index([category, published])
  @@index([sortOrder])
  @@index([fatherId])
  @@index([motherId])
}

model Product {
  id          String          @id @default(cuid())
  category    ProductCategory
  number      String
  published   Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  photos      ProductPhoto[]

  @@unique([category, number])
  @@index([category, published])
  @@index([sortOrder])
}

model ProductPhoto {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey String
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model AnimalPhoto {
  id        String   @id @default(cuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  objectKey String
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([animalId])
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
